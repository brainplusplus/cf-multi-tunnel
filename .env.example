# ── Panel ────────────────────────────────────────────────────────────
APP_NAME=CF Tunnel Panel
PORT=3001
# Port the reverse proxy (and therefore the panel) is published on.
PANEL_PORT=7777
PUBLIC_URL=http://localhost:7777

# ── Database ─────────────────────────────────────────────────────────
# In Docker this is /app/data/app.db inside the cfmt-data volume.
DB_DRIVER=sqlite
DB_PATH=./data/app.db

# ── Auth ─────────────────────────────────────────────────────────────
# Leave empty to auto-generate and persist next to the database.
# .jwt_secret and encryption.key live in the SAME persistent folder as the
# database: back them up together or stored Cloudflare tokens become unreadable.
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=1800
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# ── Encryption (AES-256-GCM for CF API tokens / tunnel secrets) ──────
# 32-byte key, base64. Leave empty to auto-generate in <data dir>/encryption.key
ENCRYPTION_KEY=

# ── Bootstrap admin (created only when the user table is empty) ──────
# Simple on purpose so the first start just works. Only an EMPTY value is
# refused. If it is still "admin123" (or under 10 characters) the backend
# logs a warning — change it in the UI before exposing the panel publicly.
# Read only on the very first start; afterwards change it in the UI.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# ── Connector ────────────────────────────────────────────────────────
# Default only. Each tunnel stores its own placement:
#   location=local  -> cloudflared runs on this host, panel supervises it
#   location=remote -> cloudflared runs on another device, panel only does
#                      ingress + DNS through the Cloudflare API
# docker   = panel runs one cloudflared container per local tunnel
# external = panel never starts anything; you run cloudflared yourself
CONNECTOR_MODE=docker
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
DOCKER_BIN=docker
# Docker network local connectors join. It must be the same network the panel
# is on, otherwise a tunnel cannot serve the panel itself.
# docker-compose sets this to "cfmt-panel"; leave empty on bare metal.
CONNECTOR_DOCKER_NETWORK=
# Address a LOCAL connector uses to reach the panel. For a tunnel on another
# device the connector must reach PUBLIC_URL instead.
PANEL_INTERNAL_URL=http://host.docker.internal:7777

# ── Logging ──────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
