{
  "name": "cf-multi-tunnel",
  "private": true,
  "scripts": {
    "dev:frontend": "cd apps/frontend && bun run dev",
    "dev:backend": "cd apps/backend && go run .",
    "dev:proxy": "cd apps/reverse-proxy && go run .",
    "dev": "concurrently --kill-others \"bun run dev:backend\" \"bun run dev:frontend\" \"bun run dev:proxy\"",
    "build:frontend": "bun scripts/build.mjs frontend",
    "build:backend": "bun scripts/build.mjs backend",
    "build:proxy": "bun scripts/build.mjs proxy",
    "build": "bun scripts/build.mjs all",
    "prod:backend": "bun scripts/run.mjs backend",
    "prod:proxy": "bun scripts/run.mjs reverse-proxy",
    "prod": "concurrently --kill-others \"bun run prod:backend\" \"bun run prod:proxy\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
